# --- Anthropic ---------------------------------------------------------------
# Get a key at https://console.anthropic.com  (or run `ant auth login` and leave blank)
ANTHROPIC_API_KEY=sk-ant-...
# Model used for both generation and refinement
ANTHROPIC_MODEL=claude-opus-5-5
# Reasoning effort per endpoint: low | medium | high | xhigh | max
GENERATE_EFFORT=medium
REFINE_EFFORT=low

# --- Server ------------------------------------------------------------------
PORT=8000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# SQLite file location (created automatically)
DATABASE_PATH=./workspace.db
